## Endpoint Object Template

```json
{
  "path": "string",
  "method": "string",
  "status": "integer",
  "auth_required": "boolean",
  "response": "string",
  "parameters": ["string"],
  "tested_payloads": ["string"],
  "vulnerability_indicators": ["string"],
  "cvss_if_auth_bypass": "float (optional)",
  "host_header_injection_testable": "boolean (optional)",
  "content_type_confusion_testable": "boolean (optional)"
}
```

---

## Example: SOQL Query Endpoint

```json
"soql_query": {
  "path": "/tw/services/data/v{version}/query/",
  "method": "GET",
  "status": 401,
  "auth_required": true,
  "parameters": ["q (SOQL query string)"],
  "tested_payloads": [
    "SELECT Id FROM Account LIMIT 1",
    "SELECT Id FROM Account WHERE Name LIKE '%' OR 1=1--",
    "SELECT Id,Username FROM User",
    "SELECT Id FROM Account UNION SELECT Id FROM User"
  ],
  "response": "INVALID_SESSION_ID",
  "vulnerability_indicators": [
    "SOQL injection vector in 'q' parameter",
    "UNION injection possible if auth bypassed",
    "Always-true condition bypass (OR 1=1)",
    "User object enumeration if query for credential harvesting"
  ],
  "cvss_if_auth_bypass": 8.6
}
```

