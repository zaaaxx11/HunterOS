# ─── VERSION ───
version() {
    echo "predator-recon v$VERSION"
}

# ─── REFERENCE COMMANDS ───
cmd_ref() {
    local subcmd="${1:-}"
    shift || true

    case "$subcmd" in
        recon|methodology)
            if [[ -f "$REF_DIR/recon-methodology.md" ]]; then
                cat "$REF_DIR/recon-methodology.md" | less
            else
                echo -e "${RED}Reference not found: $REF_DIR/recon-methodology.md${NC}"
                echo "Run: predator-recon sync-ref"
            fi
            ;;
        subdomain|sub)
            show_section "SUBDOMAIN ENUM" 50
            ;;
        urls|url)
            show_section "URL HARVEST" 40
            ;;
        js)
            show_section "JS FILES" 30
            ;;
        vuln)
            local vuln_class="${1:-}"
            if [[ -z "$vuln_class" ]]; then
                echo -e "${YELLOW}Usage: predator-recon ref vuln <xss|sqli|ssrf|idor|cors|redirect|ssti|rce>${NC}"
                return 1
            fi
            search_vuln_ref "$vuln_class"
            ;;
        infra)
            show_section "INFRA" 40
            ;;
        onchain)
            show_section "ONCHAIN" 40
            ;;
        cheat|cheatsheet)
            if [[ -f "$REF_DIR/methodology-cheatsheet.md" ]]; then
                cat "$REF_DIR/methodology-cheatsheet.md"
            else
                echo -e "${RED}Cheatsheet not found. Run: predator-recon sync-ref${NC}"
            fi
            ;;
        search)
            local keyword="${1:-}"
            if [[ -z "$keyword" ]]; then
                echo -e "${YELLOW}Usage: predator-recon ref search <keyword>${NC}"
                return 1
            fi
            grep -r -i -n "$keyword" "$REF_DIR"/*.md 2>/dev/null | head -30 || echo "No matches found"
            ;;
        *)
            echo -e "${RED}Unknown ref command: $subcmd${NC}"
            echo "Available: recon, subdomain, urls, js, vuln <class>, infra, onchain, cheat, search"
            return 1
            ;;
    esac
}

show_section() {
    local section="$1"
    local lines="${2:-50}"
    if [[ -f "$REF_DIR/methodology-cheatsheet.md" ]]; then
        grep -A "$lines" "$section" "$REF_DIR/methodology-cheatsheet.md" 2>/dev/null || echo "Section not found in cheatsheet"
    else
        echo -e "${RED}Cheatsheet not found. Run: predator-recon sync-ref${NC}"
    fi
}

search_vuln_ref() {
    local class="$1"
    local found=false
    
    # Search in cheatsheet first
    if grep -i -A 20 "$class" "$REF_DIR/methodology-cheatsheet.md" 2>/dev/null; then
        found=true
    fi
    
    # Search in methodology
    if grep -i -A 20 "$class" "$REF_DIR/recon-methodology.md" 2>/dev/null; then
        found=true
    fi
    
    if [[ "$found" = false ]]; then
        echo -e "${YELLOW}No reference for '$class'. Available: xss, sqli, ssrf, idor, cors, redirect, ssti, rce${NC}"
    fi
}

# ─── SYNC REFERENCE FROM YAKLANG ───
cmd_sync_ref() {
    echo -e "${CYAN}🔄 Syncing references from yaklang/hack-skills...${NC}"
    
    local YAK_REPO="https://github.com/yaklang/hack-skills"
    local TMP_DIR="/tmp/hack-skills-sync-$$"
    
    mkdir -p "$REF_DIR"
    
    echo "Cloning repo..."
    if git clone --depth 1 --filter=blob:none --sparse "$YAK_REPO" "$TMP_DIR" 2>/dev/null; then
        cd "$TMP_DIR"
        git sparse-checkout set skills/recon-and-methodology skills/recon-for-sec 2>/dev/null
    else
        cd "$TMP_DIR" && git pull --depth 1 2>/dev/null
        git sparse-checkout set skills/recon-and-methodology skills/recon-for-sec 2>/dev/null
    fi
    
    # Copy main methodology
    if [[ -f "$TMP_DIR/skills/recon-and-methodology/SKILL.md" ]]; then
        cp "$TMP_DIR/skills/recon-and-methodology/SKILL.md" "$REF_DIR/recon-methodology.md"
        echo -e "${GREEN}✅ Copied recon-methodology.md${NC}"
    fi
    
    if [[ -f "$TMP_DIR/skills/recon-for-sec/SKILL.md" ]]; then
        cp "$TMP_DIR/skills/recon-for-sec/SKILL.md" "$REF_DIR/recon-for-sec.md"
        echo -e "${GREEN}✅ Copied recon-for-sec.md${NC}"
    fi
    
    # Generate cheatsheet from methodology
    generate_cheatsheet
    
    # Cleanup
    rm -rf "$TMP_DIR"
    
    echo -e "${GREEN}✅ Reference sync complete!${NC}"
    echo "Location: $REF_DIR"
}

generate_cheatsheet() {
    cat > "$REF_DIR/methodology-cheatsheet.md" << 'CHEAT'
