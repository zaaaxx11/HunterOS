# ─── CONFIG COMMANDS ───
cmd_config() {
    local sub="${1:-show}"
    case "$sub" in
        show)
            echo -e "${CYAN}=== CALCULUS CONFIG ===${NC}"
            cat "$CONFIG_DIR/calculus.yaml" 2>/dev/null || echo "No calculus.yaml found"
            echo -e "\n${CYAN}=== TOOLS CONFIG ===${NC}"
            cat "$CONFIG_DIR/tools.yaml" 2>/dev/null || echo "No tools.yaml found"
            ;;
        edit)
            ${EDITOR:-vim} "$CONFIG_DIR/calculus.yaml"
            ;;
        *) echo "Usage: config [show|edit]" ;;
    esac
}

# ─── ENGINE COMMANDS ───
run_engine_script() {
    local script="$1"
    shift
    local script_path="$SCRIPTS_DIR/$script"
    
    if [[ ! -f "$script_path" ]]; then
        echo -e "${RED}Script not found: $script_path${NC}"
        echo "Available scripts:"
        ls -1 "$SCRIPTS_DIR"/*.sh 2>/dev/null | sed 's/^/  /' || echo "  (none)"
        return 1
    fi
    
    # Check for --ref flag
    for arg in "$@"; do
        if [[ "$arg" == "--ref" ]]; then
            local phase_name=$(basename "$script" .sh | sed 's/phase//; s/-/ /')
            cmd_ref "$phase_name" 2>/dev/null || true
            echo ""
        fi
    done
    
    exec "$script_path" "$@"
}

# ─── MAIN DISPATCH ───
main() {
    local cmd="${1:-}"
    shift || true

    case "$cmd" in
        # Engine commands
        phase1-subdomain|phase1) run_engine_script "phase1-subdomain.sh" "$@" ;;
        phase2-urls|phase2)      run_engine_script "phase2-urls.sh" "$@" ;;
        phase3-vuln|phase3)      run_engine_script "phase3-vuln.sh" "$@" ;;
        phase4-infra|phase4)     run_engine_script "phase4-infra.sh" "$@" ;;
        phase5-onchain|phase5)   run_engine_script "phase5-onchain.sh" "$@" ;;
        auto-deep)               run_engine_script "auto-deep.sh" "$@" ;;
        auto-trojan)             run_engine_script "auto-trojan.sh" "$@" ;;
        
        # Reference commands
        ref|reference) cmd_ref "$@" ;;
        
        # Sync reference
        sync-ref) cmd_sync_ref ;;
        
        # Config
        config) cmd_config "$@" ;;
        
        # Meta
        --version|-v) version ;;
        --help|-h|help|"") usage ;;
        
        *) 
            echo -e "${RED}Unknown command: $cmd${NC}"
            usage
            exit 1
            ;;
    esac
}

main "$@"